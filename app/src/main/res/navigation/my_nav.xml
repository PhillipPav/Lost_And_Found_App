<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/my_nav"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.sit305ass3.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_createNewAdvertFragment"
            app:destination="@id/createNewAdvertFragment" />
        <action
            android:id="@+id/action_homeFragment_to_showListFragment"
            app:destination="@id/showListFragment" />
    </fragment>
    <fragment
        android:id="@+id/createNewAdvertFragment"
        android:name="com.example.sit305ass3.CreateNewAdvertFragment"
        android:label="fragment_create_new_advert"
        tools:layout="@layout/fragment_create_new_advert" >
        <action
            android:id="@+id/action_createNewAdvertFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/showListFragment"
        android:name="com.example.sit305ass3.ShowListFragment"
        android:label="fragment_show_list"
        tools:layout="@layout/fragment_show_list" >
        <action
            android:id="@+id/action_showListFragment_to_advertExpandedFragment"
            app:destination="@id/advertExpandedFragment" />
    </fragment>
    <fragment
        android:id="@+id/advertExpandedFragment"
        android:name="com.example.sit305ass3.AdvertExpandedFragment"
        android:label="fragment_advert_expanded"
        tools:layout="@layout/fragment_advert_expanded" >
        <action
            android:id="@+id/action_advertExpandedFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
</navigation>